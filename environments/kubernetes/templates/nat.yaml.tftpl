#cloud-config
package_update: true
runcmd:
  - DEBIAN_FRONTEND=noninteractive apt-get install -y iptables iptables-persistent
  - sysctl -w net.ipv4.ip_forward=1
  - echo "net.ipv4.ip_forward=1" > /etc/sysctl.d/99-nat.conf
  - |
    IFACE=$(ip -o -4 route show to default | awk '{print $5}' | head -n1)
    iptables -t nat -C POSTROUTING -s ${worker_subnet_cidr} -o "$IFACE" -j MASQUERADE 2>/dev/null || \
      iptables -t nat -A POSTROUTING -s ${worker_subnet_cidr} -o "$IFACE" -j MASQUERADE
    iptables -C FORWARD -s ${worker_subnet_cidr} -j ACCEPT 2>/dev/null || iptables -A FORWARD -s ${worker_subnet_cidr} -j ACCEPT
    iptables -C FORWARD -d ${worker_subnet_cidr} -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || iptables -A FORWARD -d ${worker_subnet_cidr} -m state --state RELATED,ESTABLISHED -j ACCEPT
    netfilter-persistent save
